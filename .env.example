# Chave da API Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado pelo agente.
EMPORIO_MODEL=claude-haiku-5-5

# Data de referência do "hoje" do agente.
#
# Os dados da loja vão de 2025-10-15 a 2026-03-22. Rodar o agente com a data real
# do sistema deixaria todos os pedidos fora das janelas de 7 dias (arrependimento)
# e 30 dias (troca por defeito), tornando impossível demonstrar essas regras.
# Por isso o "hoje" do agente é configurável e o padrão é o dia seguinte ao
# último pedido da base. Deixe em branco para usar a data real do sistema.
EMPORIO_DATA_REFERENCIA=2026-03-23
